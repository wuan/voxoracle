# VoxOracle environment file.
#
# Copy to .env (the installer does this for you) and fill in real values.
# Keep this file out of version control; it is git-ignored.
#
# DocOracle server base URL. Overrides config.yaml when set.
# VXORACLE_DOCORACLE__URL=http://192.168.0.10:8000

# Mistral cloud credentials for STT (Voxtral) and TTS. Set ONE of these.
# LLM_API_KEY is the key DocOracle already uses, so one key can cover both.
MISTRAL_API_KEY=
# LLM_API_KEY=
