[Unit]
Description=VoxOracle voice appliance (wake word -> STT -> DocOracle /ask -> TTS)
Documentation=https://github.com/wuan/voxoracle
# network-online.target/sound.target are system units; the per-user manager
# ignores them, but naming them is harmless there and correct in the system
# manager. network-online.target is pulled in by Wants so ordering works.
After=network-online.target
Wants=network-online.target
# Bound the fail-fast retry loop while `run` is still a stub (WP6).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# Runs as the invoking (non-root) user; paths are substituted by install.sh.
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=-__INSTALL_DIR__/.env
Environment=PATH=__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=__INSTALL_DIR__/.venv/bin/voxoracle run

# `voxoracle run` is a stub until WP6 lands: it exits non-zero with a clear
# message, so the service fail-fasts and retries with backoff (bounded by the
# StartLimit in [Unit]) instead of spinning.
Restart=on-failure
RestartSec=5

# Log to the journal:  journalctl -u voxoracle -f
StandardOutput=journal
StandardError=journal

[Install]
# default.target resolves in both the system manager (-> multi-user.target) and
# the per-user manager, so `enable` links the unit where it actually starts on
# boot in either scope.
WantedBy=default.target
